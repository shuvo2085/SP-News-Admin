// Sanjay Pera News (SP News) — data model
// Backend for the admin panel + public JSON API consumed by the mobile app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase pgBouncer, port 6543) used at runtime.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) used for migrations. Falls back to
  // DATABASE_URL locally where there is no separate pooler.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
  AUTHOR
}

enum ArticleStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(AUTHOR)
  bio          String?
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  articles     Article[]
  media        Media[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  order       Int        @default(0)

  // Self-relation for dropdown sub-categories (e.g. India > ...)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Articles whose PRIMARY category this is (used for the article URL)
  primaryArticles Article[] @relation("PrimaryCategory")
  // All articles filed under this category (many-to-many)
  articles        Article[] @relation("ArticleCategories")

  @@index([parentId])
}

model Tag {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  articles Article[] @relation("ArticleTags")
}

model Media {
  id           String    @id @default(cuid())
  url          String
  filename     String
  mimeType     String
  size         Int       @default(0)
  width        Int?
  height       Int?
  alt          String?
  createdAt    DateTime  @default(now())

  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  featuredIn   Article[] @relation("FeaturedImage")
}

model Article {
  id        String        @id @default(cuid())
  title     String
  slug      String        @unique
  excerpt   String?
  content   String        @default("") // rich-text HTML

  status    ArticleStatus @default(DRAFT)
  featured  Boolean       @default(false) // "Featured story"
  breaking  Boolean       @default(false) // "Breaking news"
  readTime  Int           @default(1)     // minutes
  views     Int           @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?
  keywords        String?

  // Relations
  authorId          String
  author            User      @relation(fields: [authorId], references: [id])

  featuredImageId   String?
  featuredImage     Media?    @relation("FeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)

  primaryCategoryId String?
  primaryCategory   Category? @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)

  categories        Category[] @relation("ArticleCategories")
  tags              Tag[]      @relation("ArticleTags")
  comments          Comment[]

  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([primaryCategoryId])
  @@index([publishedAt])
}

model Comment {
  id        String        @id @default(cuid())
  articleId String
  article   Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  body      String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([articleId])
  @@index([status])
}
