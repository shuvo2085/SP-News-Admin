# Copy to .env for local dev, or set these as environment variables in Render.
# Values below are PLACEHOLDERS — replace with your Supabase project's strings.

# ---- Database (Supabase) ----
# In Supabase: Project → Connect → ORMs / Connection string.
#
# DATABASE_URL = "Transaction pooler" (port 6543). Add ?pgbouncer=true.
#   Used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL = "Session pooler" (port 5432, same pooler host, IPv4-friendly).
#   Used by Prisma for migrations. Use the Session pooler (not the raw
#   "Direct connection") so it works from Render's network.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Auth ----
# Long random string used to sign admin session cookies.
# On Render the blueprint auto-generates this — leave it out there.
JWT_SECRET="replace-with-a-long-random-string"

# ---- Supabase Storage (for uploaded images) ----
# Supabase → Project Settings → API.
# If these two are set, uploads go to the "media" bucket (persistent).
# If they are unset (e.g. local dev), uploads fall back to /public/uploads.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role secret key — keep private>"
# Optional; defaults to "media".
SUPABASE_STORAGE_BUCKET="media"
